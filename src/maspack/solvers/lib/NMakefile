# This NMakefile should be run in the "x64 Native Tools Command
# Prompt", using the command
#
# > nmake /F NMakefile
#
ROOT_DIR = ..\..\..\..
LIB_TARGET_DIR = $(ROOT_DIR)\lib\Windows64
# Pardiso compiled with MKL 2026.1
PARDISO_MKL_TARGET = PardisoJNI.2026.1.dll
CC_COMP = cl # Visual Studio C/C++ compiler
CC_FLAGS = /O2 /MD /DWINDOWS_COMPILER
# location of current Java JDK:
JAVA_HOME = "C:\Program Files\Java\jdk-1.8"
# location of Intel libraries:
INTEL_HOME = "C:\Program Files (x86)\Intel\oneAPI"
MKL_HOME = $(INTEL_HOME)\mkl\2026.1


THREAD_HOME = $(INTEL_HOME)\compiler\2026.1\lib
# include directories:
CC_INCS = /I. /I$(JAVA_HOME)\include /I$(JAVA_HOME)\include\win32 /I$(MKL_HOME)\include
MKL_64 = $(MKL_HOME)"\lib"
# pardiso static libraries
PARDISO_LIBS_64 = /link /LIBPATH:$(MKL_64) mkl_intel_lp64.lib mkl_core.lib mkl_intel_thread.lib
# multithreading library. Good news - works with older version as well
LIBMP = /LIBPATH:$(THREAD_HOME) libiomp5md.lib

default: libs

libs: $(LIB_TARGET_DIR)\$(PARDISO_MKL_TARGET)

# Regenerate the JNI header whenever PardisoSolver.java's native method
# declarations change -- mirrors NMakefile.mumps's equivalent rule. Without
# this, PardisoMklJNI.obj's dependency on this header (below) is checked
# against a stale file that nothing ever regenerates: a new native method
# added to PardisoSolver.java then has no extern "C" declaration in scope
# when PardisoMklJNI.cc defines it, so it compiles and links with NO ERROR
# but under a C++-mangled symbol name instead of the plain one JNI expects
# -- silent until the JVM throws UnsatisfiedLinkError trying to call it.
maspack_solvers_PardisoSolver.h: ..\PardisoSolver.java
	$(JAVA_HOME)\bin\javac -h . -d $(ROOT_DIR)\classes \
	   -cp $(ROOT_DIR)\classes ..\PardisoSolver.java

# hybrid (preconditioned iterative) solves, shared with the MUMPS JNI library
hybridSolve.obj: hybridSolve.cc hybridSolve.h
	$(CC_COMP) $(CC_FLAGS) $(CC_INCS) /c hybridSolve.cc

# main pardiso interfac code
pardisoMkl.obj: pardisoMkl.cc pardisoMkl.h hybridSolve.h
	$(CC_COMP) $(CC_FLAGS) $(CC_INCS) /c pardisoMkl.cc  

# JNI interface
PardisoMklJNI.obj: maspack_solvers_PardisoSolver.h PardisoMklJNI.cc pardisoMkl.h hybridSolve.h hybridSolveJNI.h
	$(CC_COMP) $(CC_FLAGS) $(CC_INCS) /c PardisoMklJNI.cc  

# build command for the DLL
$(LIB_TARGET_DIR)\$(PARDISO_MKL_TARGET): PardisoMklJNI.obj pardisoMkl.obj hybridSolve.obj
	$(CC_COMP) $(CC_FLAGS) PardisoMklJNI.obj pardisoMkl.obj hybridSolve.obj \
	$(PARDISO_LIBS_64) $(LIBMP) /DLL /out:$@

# standalone test program:

pardisoMklTest.obj: pardisoMklTest.cc 
	$(CC_COMP) $(CC_FLAGS) $(CC_INCS) /c pardisoMklTest.cc

pardisoMklTest.exe: pardisoMkl.obj hybridSolve.obj pardisoMklTest.obj pardisoMkl.h
	$(CC_COMP) $(CC_FLAGS) pardisoMklTest.obj \
		pardisoMkl.obj hybridSolve.obj $(PARDISO_LIBS_64) $(LIBMP)
